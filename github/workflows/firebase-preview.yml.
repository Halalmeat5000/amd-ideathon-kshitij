# Deploy preview channels for PRs and full deploys on push to main using a Google service account.
# Secrets required:
# - FIREBASE_PROJECT_ID : your Firebase project id
# - FIREBASE_SERVICE_ACCOUNT : base64-encoded service account JSON (or raw JSON)
name: Firebase preview & deploy (service account)

on:
  pull_request:
    types: [opened, synchronize, reopened]
  push:
    branches:
      - main

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Use Node.js 18
        uses: actions/setup-node@v4
        with:
          node-version: 18

      - name: Build frontend (Vite)
        working-directory: ./frontend
        run: |
          npm ci
          npm run build

      - name: Install functions deps
        working-directory: ./backend/functions
        run: npm ci

      - name: Install firebase-tools
        run: npm install -g firebase-tools@latest

      - name: Install gcloud SDK & authenticate with service account
        uses: google-github-actions/setup-gcloud@v1
        with:
          project_id: ${{ secrets.FIREBASE_PROJECT_ID }}
          service_account_key: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}

      - name: Ensure GOOGLE_APPLICATION_CREDENTIALS is available
        id: creds
        run: |
          out="$HOME/gcloud-sa.json"
          set +e
          echo "${{ secrets.FIREBASE_SERVICE_ACCOUNT }}" | base64 --decode > "$out" 2>/dev/null
          rc=$?
          set -e
          if [ $rc -ne 0 ]; then
            echo "${{ secrets.FIREBASE_SERVICE_ACCOUNT }}" > "$out"
          fi
          echo "GOOGLE_APPLICATION_CREDENTIALS=$out" >> $GITHUB_ENV
          ls -l "$out"
        env:
          FIREBASE_SERVICE_ACCOUNT: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}

      - name: Deploy preview for pull requests (Firebase hosting channel)
        if: github.event_name == 'pull_request'
        env:
          FIREBASE_PROJECT_ID: ${{ secrets.FIREBASE_PROJECT_ID }}
        run: |
          CHANNEL="pr-${{ github.event.number }}"
          echo "Deploying hosting build to preview channel: $CHANNEL"
          firebase hosting:channel:deploy "$CHANNEL" --project "$FIREBASE_PROJECT_ID" --only hosting --message "PR #${{ github.event.number }} preview" --non-interactive

      - name: Deploy to production on main
        if: github.ref == 'refs/heads/main'
        env:
          FIREBASE_PROJECT_ID: ${{ secrets.FIREBASE_PROJECT_ID }}
        run: |
          echo "Deploying hosting and functions to project ${FIREBASE_PROJECT_ID}"
          firebase deploy --project "$FIREBASE_PROJECT_ID" --only hosting,functions --non-interactive
